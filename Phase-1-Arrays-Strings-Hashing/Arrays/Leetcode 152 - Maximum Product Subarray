// Approach 1 ----------------------------------------------------------------(TC = 293ms)
class Solution {
    public int maxProduct(int[] nums) {
        int ans = nums[0];
        for(int i = 0; i < nums.length; i++){
            int prod = 1;
            for(int j = i; j < nums.length; j++){
                prod *= nums[j];
                // check product of each subarray
                ans = Math.max(ans, prod);
            }
        }
        return ans;
    }
}


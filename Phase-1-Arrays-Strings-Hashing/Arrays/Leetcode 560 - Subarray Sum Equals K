class Solution {
    public int subarraySum(int[] nums, int k) {
        int cnt = 0;
        // check every sub array
        for(int i = 0; i < nums.length; i++){
            int sum = 0;
            for(int j = i; j < nums.length; j++){
                sum += nums[j];
                // increase sub array count 
                // if sum id equals to k
                if(sum == k){
                    cnt++;
                }
            }
        }
        return cnt;
    }
}


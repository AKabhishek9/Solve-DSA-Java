// Approach 1 (Brute Force) ----------------------------------------------(Gives TLE)
class Solution {
    public boolean find132pattern(int[] nums) {
        int n = nums.length;
        // check nums[i]
        for(int i = 0; i < n; i++){
            // check nums[j]
            for(int j = i+1; j < n; j++){
                if(nums[i] < nums[j]){
                    // check nums[k]
                    for(int k = j+1; k < n; k++){
                        // check 132 pattern
                        if(nums[i] < nums[k] && nums[k] < nums[j]){
                            return true;
                        }
                    }
                }
            }
        }
        return false;
    }
}

// Approach 2 -----------------------------------------------------------------(Gives TLE)
class Solution {
    public boolean find132pattern(int[] nums) {
        int n = nums.length;
        // store val. of nums[i]
        int num_i = nums[0];
        // check val. of nums[j]
        for(int j = 1; j < n-1; j++){
            // update val. of nums[i]
            num_i = Math.min(num_i, nums[j]);
            if(num_i < nums[j]){
                // check nums[k]
                for(int k = j+1; k < n; k++){
                    // check 132 pattern
                    if(num_i < nums[k] && nums[k] < nums[j]){
                        return true;
                    }
                }
            }
        }
        return false;
    }
}


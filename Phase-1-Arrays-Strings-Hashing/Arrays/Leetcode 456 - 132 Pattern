// Approach 1 (Brute Force) ----------------------------------------------(Gives TLE)
class Solution {
    public boolean find132pattern(int[] nums) {
        int n = nums.length;
        // check nums[i]
        for(int i = 0; i < n; i++){
            // check nums[j]
            for(int j = i+1; j < n; j++){
                if(nums[i] < nums[j]){
                    // check nums[k]
                    for(int k = j+1; k < n; k++){
                        // check 132 pattern
                        if(nums[i] < nums[k] && nums[k] < nums[j]){
                            return true;
                        }
                    }
                }
            }
        }
        return false;
    }
}

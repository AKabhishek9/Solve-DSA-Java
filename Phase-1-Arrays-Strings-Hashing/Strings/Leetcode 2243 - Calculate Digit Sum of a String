class Solution {
    public String digitSum(String s, int k) {
        while(s.length() > k){
            StringBuilder sb = new StringBuilder();
            // traverse string in k groups
            for(int i = 0; i < s.length(); i += k){
                int sum = 0;
                // find sum for current group
                for(int j = i; j < s.length() && j < i+k; j++){
                    sum += s.charAt(j) - '0';
                }
                // add current group sum to stringbuilder
                sb.append(sum);
            }
            s = sb.toString();
        }
        return s;
    }
}

class Solution {
    public int pivotIndex(int[] nums) {
        int arr1[] = new int[nums.length];
        int arr2[] = new int[nums.length];
        int sum = 0;
        // find prefix sum from left
        for(int i = 0; i < nums.length; i++){
            sum += nums[i];
            arr1[i] = sum;
        }
        // find prefix sum from right
        sum = 0;
        for(int i = nums.length-1; i >= 0; i--){
            sum += nums[i];
            arr2[i] = sum;
        }
        // check condition
        for(int i = 0; i < nums.length; i++){
            if(arr1[i] == arr2[i]){
                return i;
            }
        }
        return -1;
    }
}

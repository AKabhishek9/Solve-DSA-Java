class Solution {
    public int smallestIndex(int[] nums) {
        for(int i = 0; i < nums.length; i++){
            int ans = 0;
            int num = nums[i];
            while(num >= 1){
                int digit =  num%10;
                ans += digit;
                num /= 10;

            }
            if(ans == i){
                return i;
            }   
        }
        return -1;
    }
}

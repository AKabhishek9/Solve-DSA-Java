class Solution {
    boolean isVowel(Character ch){
        if(ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' ||ch == 'u' 
        || ch == 'A' || ch == 'E' || ch == 'I' || ch == 'O' || ch == 'U'){
            return true;
        }
        return false;
    }
    public String reverseVowels(String s) {
        // covert string into arrays of char 
        char arr[] = s.toCharArray();
        int i = 0;
        int j = s.length()-1;

        while(i < j){
            // if left char is not vowel move left pointer
            if(!isVowel(arr[i])){
                i++;
            }
            // if right char is not vowel move right pointer
            else if(!isVowel(arr[j])){
                j--;
            }
            // when both char are vowel swap them
            else{
                char temp = arr[i];
                arr[i] = arr[j];
                arr[j] = temp;

                i++;
                j--;
            }
        }
        return new String(arr);
    }
}

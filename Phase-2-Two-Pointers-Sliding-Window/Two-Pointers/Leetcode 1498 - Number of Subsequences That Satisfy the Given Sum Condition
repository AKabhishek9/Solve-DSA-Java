class Solution {
    public int numSubseq(int[] nums, int target) {
        Arrays.sort(nums);
        int i = 0;
        int j = nums.length-1;
        int mod = 1000000007;
        long ans = 0;

        int[] power = new int[nums.length];

        // Precompute powers of 2
        power[0] = 1;
        for(int k = 1; k < nums.length; k++){
            power[k] = (int)((long)power[k - 1] * 2 % mod);
        }

        while(i <= j){
            // check min and max element in current window
            if(nums[i]+nums[j] <= target){
                // count possible sub sequences
                ans = (ans + power[j-i]) % mod;
                i++;
            }
            else{
                j--;
            }
        }
        return (int)ans;
    }
}

class Solution {
    public void merge(int[] nums1, int m, int[] nums2, int n) {
        int i = 0;
        int j = 0;
        int idx = 0;
        int[] ans = new int[m + n];
        // add elements from nums1 and num2 to new array after comparing
        while(i < m && j < n){
            if(nums1[i] < nums2[j]){
                ans[idx++] = nums1[i++];
            }
            else{
                ans[idx++] = nums2[j++];
            }
        }
        // if elements still left in nums1 
        while(i < m){
            ans[idx++] = nums1[i++];
        }
        // if elements still left in nums2
        while(j < n){
            ans[idx++] = nums2[j++];
        }
        // assign new Array elements to nums1
        for(int k = 0; k < m + n; k++){
            nums1[k] = ans[k];
        }
    }
}

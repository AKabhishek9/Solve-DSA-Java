// Approach 1 -------------------------------------------(TC = 1ms)
class Solution {
    public int removeDuplicates(int[] nums) {
        int cnt = 1;
        if(nums.length <=1){
            return nums.length;
        }
        for(int i = 1; i<nums.length; i++){
            if(nums[i-1] != nums[i]){
                nums[cnt++] = nums[i] ;
            }
        }
        return cnt;
    }
}

// Approach 2 ---------------------------------------------(TC = 1ms)
class Solution {
    public int removeDuplicates(int[] nums) {
        int i = 0;
        int j = i+1;
        int ans = 1;

        while(j < nums.length){
            // increase right ptr 
            while(j < nums.length && nums[i] == nums[j]){
                j++;
            }
            if(j < nums.length){
                // update the element at current index
                nums[ans] = nums[j];
                ans++;
                i = j;
            }
            j++;
        }
        // return new size of array
        return ans;
    }
}

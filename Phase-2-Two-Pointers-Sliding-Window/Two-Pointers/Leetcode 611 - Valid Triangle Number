// Approach 1 -----------------------------------------------------------(WORST TC = 1350)
class Solution {
    public int triangleNumber(int[] nums) {
        Arrays.sort(nums);
        int cnt = 0;
        for(int i = 0; i < nums.length-2; i++){
            for(int j = i+1; j < nums.length-1; j++){
                for(int k = j+1; k < nums.length; k++){
                    // check condition to build a triangle
                    if(nums[i] + nums[j] > nums[k]){
                        cnt++;
                    }
                }
            }
        }
        return cnt;
    }
}

// Approach 2 --------------------------------------------------------------------(BEST TC = 27ms)
class Solution {
    public int triangleNumber(int[] nums) {
        Arrays.sort(nums);
        int cnt = 0;
        for(int k = nums.length-1; k > 1; k--){
            int i = 0;
            int j = k-1;

            while(i < j){
                // check triangle condition
                if(nums[i]+nums[j] > nums[k]){
                    // all elements in window i to j have greater side sum
                    cnt += j-i;
                    j--;
                }
                else{
                    i++;
                }
            }
        }
        return cnt;
    }
}

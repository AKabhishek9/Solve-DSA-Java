class Solution {
    boolean isVowel(char ch){
        if(ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u'){
            return true;
        }
        return false;
    }
    public int maxVowels(String s, int k) {
        int i = 0;
        int j = 0;
        int ans = 0;
        int cnt = 0;

        while(j < s.length()){
            // if vowel found count it
            if(isVowel(s.charAt(j))){
                cnt++;
            }
            // if window gets greater than k
            if((j-i+1) > k){
                // if there is vowel on left pointer decrease cnt
                if(isVowel(s.charAt(i))){
                    cnt--;
                }
                // shrink the window
                i++;
            }
            // store max vowel in current window
            if((j-i+1) == k){
                ans = Math.max(ans, cnt);
            }
            j++;
        }
        return ans;
    }
}

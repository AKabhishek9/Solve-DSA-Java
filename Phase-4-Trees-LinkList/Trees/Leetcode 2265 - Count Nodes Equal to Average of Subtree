/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */

// Approach 1 (Brute Force) -----------------------------------------------------------------(TC = 14ms)
class Solution {
    int cnt = 0;
    int res = 0;
    private int findSum(TreeNode root){
        if(root == null){
            return 0;
        }
        // increase cnt to count total number of node
        cnt++;
        // find sum of left and right nodes 
        int leftSum = findSum(root.left);
        int rightSum = findSum(root.right);
        // return the sum of left and right by including root val
        return root.val + leftSum + rightSum;
    }
    private void dfs(TreeNode root){
        if(root == null){
            return;
        }
        // reset cnt for another subtree
        cnt = 0;
        // find the sum from current root 
        int sum = findSum(root);
        // check the given condition
        if(root.val == sum/cnt){
            res++;
        }
        // recursively find sum of left and right sub tree
        dfs(root.left);
        dfs(root.right);
    }
    public int averageOfSubtree(TreeNode root) {
        dfs(root);
        return res;
    }
}

/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode(int x) { val = x; }
 * }
 */

// Approach 1 (Using BFS) -----------------------------------------------------(TC = 16ms)
public class Codec {
    // Encodes a tree to a single string.
    public String serialize(TreeNode root) {
        if(root == null){
            return "";
        }
        Queue<TreeNode> q = new LinkedList<>();
        StringBuilder st = new StringBuilder();
        q.add(root);

        while(!q.isEmpty()){
            TreeNode node = q.poll();
            // if node is null add mark 
            if(node == null){
                st.append("a ");
                // move to another iteration
                continue;
            }
            // add node value 
            st.append(node.val + " ");
            q.add(node.left);
            q.add(node.right);
        }
        return st.toString();
    }

    // Decodes your encoded data to tree.
    public TreeNode deserialize(String data) {
        if(data == ""){
            return null;
        }
        Queue<TreeNode> q = new LinkedList<>();
        // create array
        String ch[] = data.split(" ");
        TreeNode root = new TreeNode(Integer.parseInt(ch[0]));
        q.add(root);
        int i = 1;
        while(!q.isEmpty()){
            TreeNode node = q.poll();
            // create left node
            if(!ch[i].equals("a")){
                TreeNode leftNode = new TreeNode(Integer.parseInt(ch[i]));
                node.left = leftNode;
                q.add(leftNode);
            }
            i++;
            // create right node
            if(!ch[i].equals("a")){
                TreeNode rightNode = new TreeNode(Integer.parseInt(ch[i]));
                node.right = rightNode;
                q.add(rightNode);
            }
            i++;
        }
        return root;
    }
}

// Approach 2 (Using DFS) --------------------------------------------------------------(BEST TC = 9ms)
public class Codec {
    // Encodes a tree to a single string.
    StringBuilder st;

    private void dfs(TreeNode root){
        // if node becomes null mark it
        if(root == null){
            st.append("a ");
            return;
        }
        // add char to string builder
        st.append(root.val + " ");
        // recursively add char to stringbuilder
        dfs(root.left);
        dfs(root.right);
    }
    public String serialize(TreeNode root) {
        st =  new StringBuilder();
        dfs(root);
        return st.toString();
    }

    // Decodes your encoded data to tree.
    String val[];
    int idx;

    private TreeNode dfs2(String val[]){
        // if current value is marked 
        if(val[idx].equals("a")){
            idx++;
            return null;
        }
        // use current value to create a node
        TreeNode node = new TreeNode(Integer.parseInt(val[idx++]));
        // recursively build left and right node 
        node.left = dfs2(val);
        node.right = dfs2(val);

        return node;
    }
    public TreeNode deserialize(String data) {
        idx = 0;
        val = data.split(" ");
        return dfs2(val);
    }
}


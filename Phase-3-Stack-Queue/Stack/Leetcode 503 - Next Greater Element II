// Approach 1 (Brute force) ------------------------------------------------(WORST TC = 91ms)
class Solution {
    public int[] nextGreaterElements(int[] nums) {
        int ans[] = new int[nums.length];
        for(int i = 0; i < nums.length; i++){
            ans[i] = -1; // Default value if no greater element exists
            for(int j = 1; j < nums.length; j++){
                // handels circular array
                int idx = (i+j)%nums.length;
                if(nums[idx] > nums[i]){
                    // populate array with greater element
                    ans[i] = nums[idx];
                    break;
                }
            }
        }
        return ans;
    }
}

// Approach 2 ---------------------------------------------------------------(TC = 16ms)
class Solution {
    public int[] nextGreaterElements(int[] nums) {
        int n = nums.length;
        HashMap<Integer, Integer> map = new HashMap<>();
        Stack<Integer> st = new Stack<>();
        int ans[] = new int[n];

        // double the array length to handle circular array
        for(int i = 2*n-1; i >= 0; i--){
            // if greater element found pop from the stack
            while(!st.isEmpty() && st.peek() <= nums[i%n]){
                st.pop();
            }

            if(i < n){
                // no greater element found
                if(st.isEmpty()){
                    ans[i] = -1;
                }
                // greater element found 
                else{
                    ans[i] = st.peek();
                }
            }
            // push every element 
            st.push(nums[i%n]);
        }
        return ans;
    }
}

// Approach 3 ----------------------------------------------------------------------(BEST TC = 9ms)
class Solution {
    public int[] nextGreaterElements(int[] nums) {
        Stack<Integer> stack = new Stack<>();
        int[] result = new int[nums.length];

        for(int i = 0; i < nums.length; i++){
            // if next greater element found add to array
            while(!stack.isEmpty() && nums[stack.peek()] < nums[i]){
                result[stack.pop()] = nums[i];
            }
            stack.push(i);
        }
        for(int i = 0; i < nums.length; i++){
            // check greater element  circularly
            while(!stack.isEmpty() && nums[stack.peek()] < nums[i]){
                result[stack.pop()] = nums[i];
            }
        }
        // insert -1 to array if no greater element found
        while(!stack.isEmpty()){
            result[stack.pop()] = -1;
        }
        return result;
    }
}

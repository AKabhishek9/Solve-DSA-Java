class Solution {
    public boolean validateStackSequences(int[] pushed, int[] popped) {
        Stack<Integer> st = new Stack<>();
        int i = 0;
        int j = 0;

        while(i < pushed.length){
            // push each element
            st.push(pushed[i]);
            // same element found in popped pop it
            while(!st.isEmpty() && j < popped.length
                    && st.peek() == popped[j])
            {
                st.pop();
                j++;
            }
            i++;
        }
        return st.isEmpty();
    }
}
